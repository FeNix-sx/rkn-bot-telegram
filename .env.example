# Telegram bot token from @BotFather
BOT_TOKEN=replace_with_bot_token

# 3x-ui panel (session login /login — логин и пароль из панели, не API token)
XUI_API_URL=http://127.0.0.1:2053
XUI_USERNAME=admin
XUI_PASSWORD=replace_with_panel_password

# Remark или tag нужного inbound в панели; приоритетнее числовой id из панели:
# XUI_INBOUND_ID=3
XUI_INBOUND_TAG=vless_reality
# Публичный IP/домен для vless:// (если в inbound listen 0.0.0.0 или панель на другом хосте, чем VPN)
# XUI_VLESS_HOST=89.125.85.47
# Тихий опрос панели и обновление сессии (сек). 0 — выключить. По умолчанию 3600.
# XUI_KEEPALIVE_SECONDS=3600

# Comma-separated Telegram admin IDs
ADMIN_IDS=123456789

# Trial duration in days
TRIAL_DAYS=3

# SQLite: на сервере укажи путь к уже существующей БД (копия/тот же файл с прод-данными)
# DB_PATH=/var/lib/rkn-bot/bot.sqlite3
DB_PATH=./data/bot.sqlite3
