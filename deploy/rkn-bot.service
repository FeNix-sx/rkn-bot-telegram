# Скопировать: cp deploy/rkn-bot.service /etc/systemd/system/
# Затем: systemctl daemon-reload && systemctl enable --now rkn-bot
#
# Важно: DB_PATH относительно WorkingDirectory (например ./data/...).

[Unit]
Description=RKN Telegram Bot (aiogram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rknbot
Group=rknbot
WorkingDirectory=/opt/rkn-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/rkn-bot/.env
ExecStart=/opt/rkn-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
