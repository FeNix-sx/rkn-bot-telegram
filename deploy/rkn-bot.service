# Пример systemd: скопируй в /etc/systemd/system/rkn-bot.service,
# поправь пути и пользователя, затем: systemctl daemon-reload && systemctl enable --now rkn-bot
#
# Важно: при DB_PATH=./data/bot.db каталог data/ считается от WorkingDirectory.

[Unit]
Description=RKN Telegram Bot (aiogram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=rknbot
# Group=rknbot
WorkingDirectory=/opt/rkn-bot
Environment=PYTHONUNBUFFERED=1
# Подхват переменных без кавычек вокруг значений (как в .env)
EnvironmentFile=-/opt/rkn-bot/.env
ExecStart=/opt/rkn-bot/.venv/bin/python -m bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
